# agent-stack: agentmemory daemon as a systemd user service (Linux).
# Replace __AGENTMEMORY_BIN__ and __NODE_DIR__ (and __DATA_DIR__ if the store is not in the default
# place, otherwise delete that variable), copy to ~/.config/systemd/user/agentmemory.service, then:
#   systemctl --user daemon-reload && systemctl --user enable --now agentmemory
# `env -i` starts the daemon with an empty environment: user services otherwise inherit whatever the
# desktop session exported (OPENAI_API_KEY, ...), and agentmemory would send memory text there.
[Unit]
Description=agentmemory daemon (agent-stack)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/.agentmemory
ExecStart=/usr/bin/env -i HOME=%h CI=1 PATH=__NODE_DIR__:/usr/local/bin:/usr/bin:/bin AGENTMEMORY_DATA_DIR=__DATA_DIR__ __AGENTMEMORY_BIN__
ExecStop=/usr/bin/env -i HOME=%h PATH=__NODE_DIR__:/usr/local/bin:/usr/bin:/bin __AGENTMEMORY_BIN__ stop
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
